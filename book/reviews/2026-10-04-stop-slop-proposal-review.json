  "findings": [
    {
      "id": "SS-01",
      "severity": "medium",
      "status": "repaired_and_independently_verified",
      "path": "integrations/stop-slop-refined/proposal/files/scripts/check_review_inputs.mjs",
      "initial_lines": [
        139,
        141
      ],
      "summary": "Entrypoint symlinks silently bypass CLI validation and exit 0",
      "reproduction": [
        {
          "label": "direct",
          "argv": [
            "node",
            "${PROJECT_ROOT}/integrations/stop-slop-refined/proposal/files/scripts/check_review_inputs.mjs",
            "--manifest",
            "${PROJECT_ROOT}/integrations/stop-slop-refined/proposal/files/tests/fixtures/review-inputs/stale-candidate.json",
            "--root",
            "${PROJECT_ROOT}/integrations/stop-slop-refined/proposal/files/tests/fixtures/review-inputs"
          ],
          "exit": 1,
          "stdout": "",
          "stderr": "{\"status\":\"rejected\",\"code\":\"STALE_INPUT\",\"message\":\"input candidate (candidate) has changed bytes\"}\n"
        },
        {
          "label": "symlink",
          "argv": [
            "node",
            "${PROJECT_ROOT}/.local/stop-slop-independent-review-4almhd3a/checker-alias.mjs",
            "--manifest",
            "${PROJECT_ROOT}/integrations/stop-slop-refined/proposal/files/tests/fixtures/review-inputs/stale-candidate.json",
            "--root",
            "${PROJECT_ROOT}/integrations/stop-slop-refined/proposal/files/tests/fixtures/review-inputs"
          ],
          "exit": 0,
          "stdout": "",
          "stderr": ""
        }
      ],
      "cause": "Node resolves a symlinked entrypoint in import.meta.url while process.argv[1] retains the alias; lexical equality skips main.",
      "requested_fix": "Resolve entrypoint identities, or use a separate CLI wrapper; add positive, stale and malformed-input symlink invocation regression cases.",
      "repair_verification": {
        "patch_sha256": "fee91932f93a2abebe5d45c2404848a91f502bf18bde23fa7572b0e5e6d23ba0",
        "implementation_change": "Compare realpaths of argv[1] and import.meta.url before calling main; no checker or manifest-schema changes.",
        "provided_regressions_passed": 18,
        "independent_cli_cases_passed": 18,
        "module_import_does_not_execute_main": true
      }
    }
  ],
